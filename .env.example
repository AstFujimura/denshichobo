APP_NAME=laravel
APP_ENV=local
APP_KEY=base64:REIiP66FwmQfFZEb5cND8Lb4+o8hmZTZ7XHObNaMpZM=
APP_DEBUG=false
APP_URL=http://192.168.100.124
APP_DISPLAY_VERSION=5.9.0
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# TAMERU AI OCR provider: gemini / internal（社内AI）
TAMERU_AI_OCR_PROVIDER=gemini
# 社内AI OCR（全テナント共通）
# 例: http://192.168.100.124:10003 （http:// を付ける）
INTERNAL_AI_OCR_BASE_URL=
INTERNAL_AI_OCR_LEDGER_PATH=/ocr/ledger
INTERNAL_AI_OCR_TOKEN=
INTERNAL_AI_OCR_TIMEOUT=60
# true: OCR失敗時に step/trace_id を alert、laravel.log に詳細、API に raw を含める
TAMERU_AI_OCR_TRACE=false

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=denshichobo
# 共通アプリユーザー（CRUD。CREATE DATABASE は持たせない想定）
DB_USERNAME=binder_app
DB_PASSWORD=secret

# ---------------------------------------------------------------------------
# Multi-tenant DB connections
# - app:     DB_* / CONTROL_DB_* / TENANT_DB_*  → 共通 binder_app
# - provision: PROVISION_DB_*                  → CREATE DATABASE 可の別ユーザー
# 開発中に同一ユーザーでも動くが、本番相当では必ず分ける。
# 確認: php artisan tenancy:db-check
# ---------------------------------------------------------------------------

# Control plane DB (tenant registry / platform admins)
CONTROL_DB_HOST=127.0.0.1
CONTROL_DB_PORT=3306
CONTROL_DB_DATABASE=binder_control
CONTROL_DB_USERNAME=binder_app
CONTROL_DB_PASSWORD=secret

# Tenant connection defaults (database name is switched at runtime from tenants.db_database)
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=3306
TENANT_DB_USERNAME=binder_app
TENANT_DB_PASSWORD=secret

# Privileged provisioning connection (CREATE DATABASE only / CLI & jobs)
# Do NOT use this connection from normal HTTP request paths.
PROVISION_DB_HOST=127.0.0.1
PROVISION_DB_PORT=3306
PROVISION_DB_DATABASE=binder_control
PROVISION_DB_USERNAME=binder_provision
PROVISION_DB_PASSWORD=secret

# true にすると tenancy:db-check が「app と provision が同一」をエラーにする
TENANCY_REQUIRE_SEPARATE_PROVISION_USER=false

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120


MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=null
AWS_SECRET_ACCESS_KEY=null

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

SESSION_LIFETIME=1200
