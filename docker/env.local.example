# コンテナの Apache (www-data) が読む。600 だと Web から APP_KEY を読めず 500 になる。
APP_NAME=laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:12300
APP_DISPLAY_VERSION=5.9.0

GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

TAMERU_AI_OCR_PROVIDER=gemini
INTERNAL_AI_OCR_BASE_URL=
INTERNAL_AI_OCR_LEDGER_PATH=/ocr/ledger
INTERNAL_AI_OCR_TOKEN=
INTERNAL_AI_OCR_TIMEOUT=60
TAMERU_AI_OCR_TRACE=false
GHOSTSCRIPT_PATH=/usr/bin/gs

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=denshichobo_control
DB_USERNAME=denshichobo_app
DB_PASSWORD=

CONTROL_DB_HOST=host.docker.internal
CONTROL_DB_PORT=3306
CONTROL_DB_DATABASE=denshichobo_control
CONTROL_DB_USERNAME=denshichobo_app
CONTROL_DB_PASSWORD=

TENANT_DB_HOST=host.docker.internal
TENANT_DB_PORT=3306
TENANT_DB_USERNAME=denshichobo_app
TENANT_DB_PASSWORD=

PROVISION_DB_HOST=host.docker.internal
PROVISION_DB_PORT=3306
PROVISION_DB_DATABASE=denshichobo_control
PROVISION_DB_USERNAME=denshichobo_provision
PROVISION_DB_PASSWORD=

TENANCY_REQUIRE_SEPARATE_PROVISION_USER=true

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=1200

MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=null
AWS_SECRET_ACCESS_KEY=null
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
